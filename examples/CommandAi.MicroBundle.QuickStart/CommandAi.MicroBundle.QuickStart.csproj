<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePackedCommandAiMicroBundle)' != 'true'">
    <ProjectReference Include="../../microbundle/TheSingularityWorkshop.CommandAi.MicroBundle.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackedCommandAiMicroBundle)' == 'true'">
    <PackageReference Include="TheSingularityWorkshop.CommandAi.MicroBundle" Version="$(CommandAiMicroBundlePackageVersion)" />
  </ItemGroup>
</Project>