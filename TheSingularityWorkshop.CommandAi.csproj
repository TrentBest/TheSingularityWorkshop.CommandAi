<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <IsPackable>true</IsPackable><PackageId>TheSingularityWorkshop.CommandAi</PackageId><Version>0.1.0-alpha.1</Version>
    <Authors>Trent Best</Authors><Company>The Singularity Workshop</Company>
    <Description>Provider-neutral command proposals and deterministic integer-backed command envelopes for AI-integrated applications.</Description>
    <PackageTags>AI;LLM;commands;structured-output;protocol;TheSingularityWorkshop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile><PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/TrentBest/TheSingularityWorkshop.CommandAi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.CommandAi</RepositoryUrl><RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile><NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" /><None Remove="tests/**" /><Compile Remove="examples/**/*.cs" /><None Remove="examples/**" />
    <None Include="README.md" Pack="true" PackagePath="" /><None Include="LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>